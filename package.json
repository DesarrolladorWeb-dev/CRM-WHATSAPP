{
  "name": "whato-crm",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "whato-crm - Omnichannel CRM with WhatsApp Web extension, AI Gemini & MongoDB",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "prestart": "node scripts/prestart-migrate.mjs",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-hybrid.ts",
    "db:seed:legacy": "node scripts/migrate.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:apikeys-hash": "node scripts/migrate-apikeys-hash.mjs",
    "migrate:timestamps": "node scripts/migrate-timestamps-lima.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.10.2",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.4.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
