# Copia este archivo a .env.local y rellena los valores. Los valores de abajo son
# PLACEHOLDERS de desarrollo (usuario/password de ejemplo, "tu_api_key_...");
# reemplazalos todos antes de desplegar y nunca comitees tu .env real.
#
# Minimo obligatorio en produccion (NODE_ENV=production):
#   - API_KEY_HASH_SECRET  -> openssl rand -hex 32
#   - GEMINI_API_KEY       -> clave real de Google AI Studio
#   - GEMINI_MODEL         -> ID de un modelo disponible con generacion JSON
#   - DATABASE_URL         -> con usuario y password reales (no el de ejemplo)
#   - MONGODB_URI          -> con credenciales si el cluster las exige

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Google Gemini AI (backend, nunca se expone al cliente)
GEMINI_API_KEY=
# Verifica disponibilidad para tu clave. Sin valor predeterminado en el codigo.
GEMINI_MODEL=gemini-3.6-flash

# --- Bases de datos del hibrido ---------------------------------------------

# Postgres: nucleo relacional (Prisma). Contactos, segmentos, campañas,
# automatizaciones, conversaciones, API keys, etc.
#   npm run db:migrate:dev   (crea/aplica migraciones en desarrollo)
#   npm run db:seed          (puebla Postgres + Mongo desde src/seedData.json)
#   npm start                (produccion: corre "prisma migrate deploy" solo antes de arrancar)
# EJEMPLO: usuario=postgres, password=root   DATABASE_URL=postgresql://postgres:root@localhost:5432/whato_crm?schema=public
#
# PRODUCCION (Postgres gestionado, ej. Neon): agrega connection_limit y
# pool_timeout a la URL. El proceso es persistente (Docker/VPS, un solo
# PrismaClient singleton, ver src/lib/postgres.ts), asi que basta con fijar
# un limite acorde al plan del proveedor -- no hace falta PgBouncer aparte.
#   DATABASE_URL=postgresql://usuario:password@ep-xxx.neon.tech/whato_crm?sslmode=require&connection_limit=10&pool_timeout=20
DATABASE_URL=postgresql://usuario:password@localhost:5432/whato_crm?schema=public

# MongoDB: historial de chat (messages) y bitacora de webhooks (webhooklogs).
# PRODUCCION (MongoDB Atlas): usa la cadena "mongodb+srv://..." que da el
# cluster. Ver seccion 3.2 del README para el paso a paso de Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/whato-crm

# Pool de conexiones del driver de Mongo (opcional). Con un solo proceso
# persistente, los valores por defecto (max 10 / min 1, ver src/lib/mongodb.ts)
# alcanzan para el trafico de un CRM chico; solo tocalos si el plan de Atlas
# limita las conexiones concurrentes o si el trafico crece.
# MONGODB_POOL_MAX=10
# MONGODB_POOL_MIN=1

# --- Multimedia de los mensajes ---------------------------------------------
#
# Carpeta donde se guardan las imagenes/audio/video/documentos de los chats
# (en vez de guardarlos como base64 dentro de MongoDB). Ruta relativa al
# directorio de trabajo o absoluta. Los archivos se sirven con autenticacion
# en GET /api/media/<conversationId>/<archivo>.
#
# PRODUCCION CON DOCKER/DOKPLEY: monta un volumen persistente en esa carpeta
# para que la multimedia sobreviva a los redeploys, p. ej.:
#   volumes:
#     - whato_media:/app/storage/media
MEDIA_STORAGE_DIR=storage/media

# Modo demo. Por defecto, si Postgres o Mongo no responden las rutas de la API
# devuelven 503 (y el frontend muestra un aviso de "datos de ejemplo"). Con
# DEMO_MODE=true las rutas caen a los datos de ejemplo de src/mockData.ts
# (source: 'demo') para poder enseñar la UI sin bases de datos levantadas.
DEMO_MODE=false

# --- Seguridad de API keys -------------------------------------------------

# Secreto (pepper) para el hash HMAC-SHA256 de las API keys
# (src/lib/apiKeySecurity.ts). OBLIGATORIO en produccion: si falta con
# NODE_ENV=production el servidor aborta el arranque y cualquier operacion con
# claves lanza error, en vez de caer a un pepper de desarrollo publico.
# Genera uno con:
#   openssl rand -hex 32
# Rotarlo invalida TODAS las API keys ya emitidas: hay que re-emitirlas.
API_KEY_HASH_SECRET=


# --- CORS -------------------------------------------------------------------

# Origenes permitidos para llamar a /api/* desde otro dominio (navegador),
# separados por comas y con esquema. Vacio = solo mismo origen. En desarrollo
# se aceptan ademas localhost / 127.0.0.1 en cualquier puerto.
#   Ej: CORS_ALLOWED_ORIGINS=https://app.miempresa.com,https://admin.miempresa.com
CORS_ALLOWED_ORIGINS=

# --- Endpoint destructivo de seed ----------------------------------------------

# POST /api/seed BORRA y repuebla ambas bases de datos. En produccion
# (NODE_ENV=production) esta deshabilitado (403) salvo que se ponga esto en
# 'true' de forma deliberada. Se lee en build: cambiarlo exige redeploy.
# Ademas, en produccion la request debe incluir { "confirm": "RESET-WHATO-DB" }.
# Deshabilitalo de nuevo en cuanto termines el primer arranque.
ALLOW_DESTRUCTIVE_SEED=false

# Modelo de Gemini para las rutas de /api/ai. Si se omite se usa
# 'gemini-3.6-flash'. Solo cambialo por un id estable y vigente:
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.6-flash
# --- Servicio local de WhatsApp (REST + Socket.IO) ---------------------------

# URL del servicio de WhatsApp que corre aparte (por defecto http://localhost:3001).
#
# Son DOS variables porque hay dos consumidores con vistas distintas de la red:
#
#   NEXT_PUBLIC_WHATSAPP_SERVICE_URL -> la usa el NAVEGADOR (Socket.IO y envio
#     directo desde el chat). Tiene que ser la URL publica del servicio.
#
#   WHATSAPP_SERVICE_URL -> la usa el SERVIDOR (el despacho de campanas, que
#     envia sin que nadie mire). Debe ser una direccion alcanzable DESDE DENTRO
#     de la maquina o la red del contenedor: http://localhost:3001,
#     http://127.0.0.1:3001 o el nombre del servicio en Docker.
#     Si se deja vacia se cae a la publica, y si el CRM y el servicio viven en
#     el mismo servidor detras de un proxy eso falla con «fetch failed»: el
#     contenedor no puede salir a internet y volver a entrar por su propia IP.
#     Sintoma tipico: el CRM muestra WhatsApp conectado pero TODAS las campanas
#     terminan en «Fallida» con 0 enviados.
WHATSAPP_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_WHATSAPP_SERVICE_URL=http://localhost:3001

# --- WhatsApp Business Cloud API --------------------------------------------

# Credenciales de la app de Meta. Sin ellas la app guarda los mensajes en la
# base pero no los envia a WhatsApp; el webhook de recepcion tampoco valida
# firmas y rechaza todo lo entrante.
#
# WHATSAPP_ACCESS_TOKEN     token permanente de la app (Meta for Developers)
# WHATSAPP_PHONE_NUMBER_ID  id del numero emisor
# WHATSAPP_APP_SECRET       secreto de la app; verifica X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN     cadena que elegimos nosotros; Meta la usa al dar
#                           de alta el webhook (handshake del GET)
# WHATSAPP_GRAPH_VERSION    version de la Graph API (por defecto v21.0)
#
# El webhook se configura en Meta apuntando a:
#   https://TU_DOMINIO/api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v21.0

# --- Sesiones de usuario ---------------------------------------------------

# Secreto para firmar los JWT de sesion (src/lib/auth.ts, userRepo.ts).
# OBLIGATORIO: sin el, el login responde 500 porque jose no puede firmar con
# una clave vacia. Genera uno con:
#   openssl rand -hex 32
# Rotarlo invalida todas las sesiones abiertas: los usuarios vuelven al login.
JWT_SECRET=

# Coste de bcrypt para hashear contrasenas. Por defecto 10, que es un buen
# equilibrio entre seguridad y latencia del login. Subirlo encarece cada
# intento de fuerza bruta pero tambien cada login legitimo.
# SALT_ROUNDS=10
SALT_ROUNDS=
# Sin esto el servidor formatea en la zona del contenedor, que suele ser UTC, y
# las horas salen 5 horas adelantadas respecto a Peru.
BUSINESS_TIME_ZONE=America/Lima
# Misma zona, pero visible para el NAVEGADOR. Next solo inyecta al cliente las
# variables NEXT_PUBLIC_*, asi que el formulario de campanas no puede leer
# BUSINESS_TIME_ZONE. Si cambias la zona del negocio, cambia LAS DOS: si no, el
# selector de fecha etiquetaria las horas con una zona y el servidor las
# interpretaria con otra, y la campana saldria a una hora distinta de la que
# el usuario leyo en pantalla.
NEXT_PUBLIC_BUSINESS_TIME_ZONE=America/Lima

# Zona del proceso Node. Alinea logs y cualquier formateo que no pase por
# src/lib/time.ts. No afecta lo que se guarda en Postgres (siempre UTC).
TZ=America/Lima

# --- Worker de campanas -----------------------------------------------------

# Secreto para el disparador externo del worker: POST/GET /api/campaigns/tick.
# Esa ruta lanza las campanas programadas que ya vencieron, asi que esta
# EXCEPTUADA de la sesion JWT (un cron no tiene sesion) y este secreto es su
# unico guardian. Se envia en la cabecera `x-cron-secret` o como
# `Authorization: Bearer <secreto>`.
# Genera uno con:
#   openssl rand -hex 32
# Si se deja vacio la ruta responde 503 y queda deshabilitada — falla cerrada,
# nunca abierta. NO hace falta en el despliegue normal (proceso Node
# persistente): ahi el worker ya corre solo cada minuto desde
# src/instrumentation.ts. Solo se necesita para forzar un tick a mano o si se
# despliega en serverless, donde el temporizador interno no sobrevive.
CRON_SECRET=

# --- n8n (máquina-a-máquina) --------------------------------------------------

# Secreto para que n8n escriba sin sesión JWT: POST /api/whatsapp/webhook
# (crear entrante) y POST /api/messages (guardar respuesta del bot).
# Se envía en la cabecera `x-n8n-secret` o como `?secret=`.
# Genera uno con:
#   openssl rand -hex 32
# Sin esto n8n necesita el nodo HTTP Login + cookie `session_token` (frágil:
# expira en 7 días). Con esto se borra ese nodo.
# Si se deja vacío, esas rutas exigen sesión como antes — falla cerrado.
N8N_WEBHOOK_SECRET=
# --- Google Analytics -------------------------------------------------------

# ID de medicion de GA4 (formato G-XXXXXXXXXX). Si esta vacio no se carga el
# script y el CSP no abre permisos para googletagmanager: asi las visitas de
# desarrollo no ensucian las metricas de produccion.
# Se configura en el entorno del despliegue, no aqui.
NEXT_PUBLIC_GA_ID=
